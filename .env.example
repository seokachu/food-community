# .env.local로 복사한 뒤 실제 값을 채운다.
# Supabase — 서버 전용(BFF). NEXT_PUBLIC_ 접두사를 붙이지 않는다(클라이언트 번들 노출 금지).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Storage 공개 객체 기본 주소. 이미지 URL은 `<이 값>/<버킷>/<파일경로>`로 조립한다.
SUPABASE_STORAGE_URL=https://<project-ref>.supabase.co/storage/v1/object/public

# 관리자 작업(RLS 우회)이 필요해지면 대시보드에서 secret key를 발급해 추가한다.
# SUPABASE_SECRET_KEY=

# 네이버 지도(NCP Maps · Dynamic Map) Client ID.
# 네이버 클라우드 플랫폼 콘솔 > Application 에서 발급하고, 서비스 URL에 도메인을 등록해야 동작한다.
# 서버 컴포넌트가 읽어 프롭으로 내려보내므로 NEXT_PUBLIC_ 접두사는 붙이지 않는다.
NAVER_MAP_CLIENT_ID=

# 위와 같은 Maps Application 의 Client Secret.
# 리버스 지오코딩 BFF(GET /api/reverse-geocode)에서만 읽는 서버 전용 값이라 클라이언트에 노출되지 않는다.
NAVER_MAP_CLIENT_SECRET=

# 네이버 지역검색(NCP API Hub · Search > Local) Client ID / Client Secret.
# 네이버 클라우드 플랫폼 콘솔 > Application 에서 지역검색 API 를 켠 앱의 인증 정보다.
# BFF(GET /api/place-search)에서만 읽는 서버 전용 값이라 클라이언트에 노출되지 않는다.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
